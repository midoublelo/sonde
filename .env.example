# TfL API key (optional). Without it you're capped at 50 requests/hour. 
# Register at: https://api-portal.tfl.gov.uk/
TFL_APP_KEY=

# OpenWeatherMap API key (required for weather ingestion). Free tier is
# 60 calls/min and 1,000,000 calls/month.
# Register at: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=

# Use your own CARTO API key to avoid rate limiting or in case map fails to render. 
# Register at: https://carto.com/basemaps/apikey/
CARTO_API_KEY=

# SQLite by default. Swap to a Postgres URL later without changing any code
# that uses src/storage/db.py.
DATABASE_URL=sqlite:///data/tube.db